, (e) => {\n    if (e.code === \"Space\" || e.code === \"ArrowUp\") {\n        e.preventDefault();\n        jump();\n    }\n});\n\ncanvas.addEventListener(\"click\", jump);\n\nfunction createObstacle() {\n    obstacles.push({\n        x: 800,\n        y: 320,\n        width: 30,\n        height: 30\n    });\n}\n\nfunction restart() {\n    player.y = 300;\n    player.velocity = 0;\n    player.jumping = false;\n    obstacles = [];\n    score = 0;\n    speed = 6;\n    gameOver = false;\n    loop();\n}\n\nfunction update() {\n    if (gameOver) return;\n\n    // Физика прыжка\n    player.velocity += gravity;\n    player.y += player.velocity;\n\n    if (player.y >= 300) {\n        player.y = 300;\n        player.velocity = 0;\n        player.jumping = false;\n    }\n\n    // Движение препятствий\n    obstacles.forEach((obstacle, index) => {\n        obstacle.x -= speed;\n\n        // Проверка столкновения\n        if (\n            player.x < obstacle.x + obstacle.width &&\n            player.x + player.width > obstacle.x &&\n            player.y < obstacle.y + obstacle.height &&\n            player.y + player.height > obstacle.y\n        ) {\n            gameOver = true;\n        }\n\n        // Очки\n        if (obstacle.x + obstacle.width < player.x &&\n            !obstacle.passed) {\n            score++;\n            obstacle.passed = true;\n            speed += 0.2;\n        }\n    });\n\n    obstacles = obstacles.filter(o => o.x > -50);\n\n    if (Math.random() < 0.015) {\n        createObstacle();\n    }\n}\n\nfunction draw() {\n    ctx.clearRect(0, 0, 800, 400);\n\n    // Облака\n    ctx.fillStyle = \"white\";\n    ctx.beginPath();\n    ctx.arc(200, 70, 25, 0, Math.PI * 2);\n    ctx.arc(230, 70, 30, 0, Math.PI * 2);\n    ctx.arc(260, 70, 25, 0, Math.PI * 2);\n    ctx.fill();\n\n    // Земля\n    ctx.fillStyle = \"#399b45\";\n    ctx.fillRect(0, 350, 800, 50);\n\n    // Игрок\n    ctx.fillStyle = \"#ff5733\";\n    ctx.fillRect(\n        player.x,\n        player.y,\n        player.width,\n        player.height\n    );\n\n    // Глаза\n    ctx.fillStyle = \"white\";\n    ctx.fillRect(player.x + 25, player.y + 10, 7, 7);\n\n    // Препятствия\n    ctx.fillStyle = \"#236b32\";\n    obstacles.forEach(o => {\n        ctx.fillRect(o.x, o.y, o.width, o.height);\n    });\n\n    // Счёт\n    ctx.fillStyle = \"#17172e\";\n    ctx.font = \"25px Arial\";\n    ctx.fillText(\"Очки: \" + score, 20, 35);\n\n    // Проигрыш\n    if (gameOver) {\n        ctx.fillStyle = \"rgba(0,0,0,0.7)\";\n        ctx.fillRect(0, 0, 800, 400);\n\n        ctx.fillStyle = \"white\";\n        ctx.textAlign = \"center\";\n        ctx.font = \"45px Arial\";\n        ctx.fillText(\"ИГРА ОКОНЧЕНА!\", 400, 170);\n\n        ctx.font = \"25px Arial\";\n        ctx.fillText(\"Твой счёт: \" + score, 400, 220);\n        ctx.fillText(\"Нажми ПРОБЕЛ, чтобы начать заново\", 400, 270);\n\n        ctx.textAlign = \"left\";\n    }\n}\n\nfunction loop() {\n    update();\n    draw();\n\n    if (!gameOver) {\n        requestAnimationFrame(loop);\n    }\n}\n\nloop();\n</script>\n\n    < /body>\n    < /html>\n"]]}]}]},{"timestamp":1793432248129,"editorVersion":"4.1.27","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":12067,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"gameupdate\" x=\"134\" y=\"509\"></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1615,"diffs":[[1,">\n"]]}]}]},{"timestamp":1793432874610,"editorVersion":"4.1.27","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":1,"diffs":[[1,"namespace SpriteKind {\n    export const Obstacle = SpriteKind.create()\n}\n// Столкновение\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Obstacle, function (sprite, otherSprite) {\n    game.over(false)\n})\n// Прыжок\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (player2.y >= 99) {\n        playe